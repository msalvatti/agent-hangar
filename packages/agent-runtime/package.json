{
  "name": "@agent-hangar/agent-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Code that runs inside workspace containers: the turn loop, tools and NDJSON protocol bridge (bundled with esbuild).",
  "type": "module",
  "bin": {
    "agent-runtime": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bash ../../scripts/tsc-build.sh && node esbuild.config.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "lint": "eslint .",
    "typecheck": "bash ../../scripts/tsc-build.sh",
    "test": "vitest run",
    "test:mutation": "stryker run",
    "test:mutation:scoped": "stryker run --incrementalFile .stryker-tmp/inc-scoped.json --mutate",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agent-hangar/core": "workspace:*",
    "openai": "^7.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.2"
  }
}
