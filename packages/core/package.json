{
  "name": "@agent-hangar/core",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-free domain core: contracts, protocol codec, config, persistence, runner and model provider ports.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "development": "./src/testing/index.ts",
      "default": "./dist/testing/index.js"
    },
    "./runner/docker": {
      "types": "./dist/runner/docker/index.d.ts",
      "development": "./src/runner/docker/index.ts",
      "default": "./dist/runner/docker/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration --coverage.enabled=false",
    "fixtures:record": "tsx scripts/record-fixtures.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bullmq": "^6.1.2",
    "cron-parser": "^5.10.0",
    "dockerode": "^5.0.1",
    "ioredis": "^6.0.0",
    "openai": "^7.5.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "tar-stream": "^3.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/tar-stream": "^3.1.4",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.9.1"
  }
}
