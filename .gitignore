# Dependencies
node_modules/

# Build output
dist/
.next/
out/
*.tsbuildinfo

# Tests and reports
coverage/
reports/
playwright-report/
test-results/
.stryker-tmp/

# Generated code
packages/core/src/persistence/generated/

# Live recordings of the OpenAI Responses stream (`pnpm --filter @agent-hangar/core
# fixtures:record`). They carry whatever the API returned for a real key and are meant to be
# diffed against the committed synthetic fixtures and then deleted — never committed.
packages/core/fixtures/openai/recorded-*.ndjson

# Local environment and secrets (never commit; `.env.example` documents the keys)
.env
.env.*
!.env.example
master.key
*.key

# Generated by an end-to-end run (master key, stack state)
apps/web/e2e/.tmp/

# Editor and OS noise
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.log
.turbo/

# Claude Code harness state (isolated agent worktrees live under .claude/worktrees/)
.claude/

# Generated by Next.js on every dev/build (references .next/ type stubs)
apps/web/next-env.d.ts
*.pem
