# Agent Hangar — environment reference.
#
# `pnpm setup` (infra/scripts/env.sh) generates .env.local from AH_INSTANCE / AH_PORT_BASE; you
# rarely need to edit anything. Every value below is the default of the `default` instance.
#
# SECRETS ARE NOT ENVIRONMENT VARIABLES: the GitHub PAT and the OpenAI API key are entered in
# Settings, encrypted with the master key and stored in Postgres. Do not put them here.

# Instance name; suffixes ports, database, compose project and container names. Conductor sets
# it from CONDUCTOR_WORKSPACE_NAME. Slugified to [a-z0-9-], max 30 characters.
AH_INSTANCE=default
# Base of a 10-port block (web = +0, Postgres = +1, Redis = +2). Conductor sets CONDUCTOR_PORT.
AH_PORT_BASE=3000

# Next.js port (derived: AH_PORT_BASE + 0).
WEB_PORT=3000
# Host port mapped to the compose Postgres (derived: AH_PORT_BASE + 1).
POSTGRES_PORT=3001
# Host port mapped to the compose Redis (derived: AH_PORT_BASE + 2).
REDIS_PORT=3002
# Database name (derived: agent_hangar_<instance>).
POSTGRES_DB=agent_hangar_default
# Prisma connection string; 127.0.0.1 (not localhost) avoids IPv6-first resolution on macOS.
DATABASE_URL=postgresql://ah:ah@127.0.0.1:3001/agent_hangar_default
# BullMQ + Redis Streams.
REDIS_URL=redis://127.0.0.1:3002
# Isolates compose containers, volumes and networks per instance.
COMPOSE_PROJECT_NAME=agent-hangar-default

# Master key that encrypts the stored secrets (0600, outside the repository).
MASTER_KEY_PATH=~/.agent-hangar/master.key
# Image used for workspace containers (built by `pnpm infra:image`).
WORKSPACE_IMAGE=agent-hangar/workspace:dev
# Container name prefix / label; the GC only touches its own instance.
WORKSPACE_NAME_PREFIX=ah-ws-default-
# Idle workspaces are destroyed after this many minutes.
WORKSPACE_IDLE_TTL_MIN=30
# Parallel chat turns processed by the worker.
WORKER_TURN_CONCURRENCY=2

# Model id sent to OpenAI.
OPENAI_MODEL=gpt-5.6-sol
# Optional OpenAI base URL override (tests point it at a fake); empty = default.
OPENAI_BASE_URL=
# `openai` or `fake` (E2E and demos without a key).
AGENT_MODEL_PROVIDER=openai
# Optional Docker socket; empty = ~/.docker/run/docker.sock, then /var/run/docker.sock.
DOCKER_HOST=
# pino log level: fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL=info
# Serve the web UI against MSW mock handlers instead of the API (development only).
NEXT_PUBLIC_API_MOCK=0
