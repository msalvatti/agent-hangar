{
  "name": "agent-hangar",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first web app where AI agents answer questions and perform coding tasks against GitHub repositories inside isolated, disposable Docker workspaces.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "bash infra/scripts/run.sh",
    "build": "pnpm -r --if-present build",
    "start": "bash infra/scripts/run.sh --production",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "bash scripts/tsc-build.sh",
    "test": "bash scripts/run-tests.sh",
    "test:integration": "pnpm -r --if-present test:integration",
    "test:e2e": "pnpm --filter web test:e2e",
    "test:mutation": "pnpm -r --if-present test:mutation",
    "setup": "bash infra/scripts/setup.sh",
    "doctor": "bash infra/scripts/doctor.sh",
    "infra:doctor": "pnpm run doctor",
    "infra:up": "bash -c 'instance_env=\"$(bash infra/scripts/env.sh --print-checked)\" && eval \"$instance_env\" && docker compose -f infra/docker-compose.yml up -d --wait'",
    "infra:down": "bash -c 'instance_env=\"$(bash infra/scripts/env.sh --print-checked)\" && eval \"$instance_env\" && docker compose -f infra/docker-compose.yml down'",
    "infra:reset": "bash -c 'instance_env=\"$(bash infra/scripts/env.sh --print-checked)\" && eval \"$instance_env\" && docker compose -f infra/docker-compose.yml down -v'",
    "infra:image": "bash infra/scripts/image.sh",
    "db:generate": "pnpm --filter @agent-hangar/core db:generate",
    "db:migrate": "bash -c 'instance_env=\"$(bash infra/scripts/env.sh --print-checked)\" && eval \"$instance_env\" && pnpm --filter @agent-hangar/core db:migrate'",
    "db:studio": "bash -c 'instance_env=\"$(bash infra/scripts/env.sh --print-checked)\" && eval \"$instance_env\" && pnpm --filter @agent-hangar/core exec prisma studio'",
    "db:prune": "bash infra/scripts/db-prune.sh",
    "ws:list": "bash infra/scripts/ws.sh list",
    "ws:reap": "bash infra/scripts/ws.sh reap",
    "archive": "bash infra/scripts/archive.sh",
    "rotate-key": "bash infra/scripts/rotate-key.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@next/eslint-plugin-next": "^16.3.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
