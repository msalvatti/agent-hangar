{
  "name": "worker",
  "version": "0.1.0",
  "private": true,
  "description": "BullMQ consumers, scheduler reconciliation and workspace garbage collection.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development src/main.ts",
    "build": "tsc -b && pnpm --filter @agent-hangar/core declarations:rewrite",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -b && pnpm --filter @agent-hangar/core declarations:rewrite",
    "test": "vitest run",
    "test:integration": "DOCKER_AVAILABLE=1 vitest run --project integration --coverage.enabled=false"
  },
  "dependencies": {
    "@agent-hangar/core": "workspace:*",
    "bullmq": "^6.1.2",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.12"
  }
}
